# Optional - leave unset to fall back to OpenStreetMap (see resolveOsmPlace.ts)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_key_here
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_key_here
# Optional - only needed if your Anthropic key is "identity-linked" (tied to
# a Console user rather than scoped to a workspace); leave unset otherwise.
# See the comment above the Anthropic client in journalVisit.ts.
EXPO_PUBLIC_ANTHROPIC_WORKSPACE_ID=
